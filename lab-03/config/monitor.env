# Trusted shell configuration. Override any value via exported environment variables.
CPU_MAX=${CPU_MAX:-90}
MEM_MAX=${MEM_MAX:-90}
DISK_MIN_FREE=${DISK_MIN_FREE:-10}
DISK_PATHS=${DISK_PATHS:-/}
# Newline-separated exact comm names (pgrep -x), and systemd unit names.
PROCESSES=${PROCESSES:-}
SERVICES=${SERVICES:-}
SAMPLE_SECONDS=${SAMPLE_SECONDS:-0.2}
